{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(*.env)",
      "Read(.env.*)",
      "Read(secrets.properties)",
      "Bash(cat *.env*)",
      "Bash(grep *.env*)",
      "Bash(npx:*)",
      "Bash(bunx:*)",
      "Bash(bun x:*)",
      "Bash(nix run:*)",
      "Bash(pnpm dlx:*)",
      "Bash(yarn dlx:*)",
      "Bash(uvx:*)",
      "Bash(pipx run:*)",
      "Bash(gh infra apply:*)"
    ],
    "ask": [
      "Bash(just secrets:*)",
      "Bash(just switch:*)",
      "Bash(just switch-home:*)",
      "Bash(just switch-darwin:*)",
      "Bash(just switch-macos:*)",
      "Bash(just switch-wsl:*)",
      "Bash(nh home switch:*)",
      "Bash(nh darwin switch:*)",
      "Bash(nh os switch:*)",
      "Bash(home-manager switch:*)",
      "Bash(darwin-rebuild switch:*)",
      "Bash(sudo darwin-rebuild switch:*)",
      "Bash(nixos-rebuild switch:*)",
      "Bash(sudo nixos-rebuild switch:*)"
    ]
  },
  "model": "opus",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts"
  },
  "enabledPlugins": {
    "ast-grep@ast-grep-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": false,
  "skipAutoPermissionPrompt": true
}
